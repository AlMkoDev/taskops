# AgriReports Environment Configuration
# Copy this file to .env.local and update values

# ============================================================
# Application
# ============================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Database (PostgreSQL)
# ============================================================
# Option 1: Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrireports

# Option 2: Comment out above and use your own connection string
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================
# Redis (for Queue System)
# ============================================================
# Option 1: Local Redis
REDIS_URL=redis://localhost:6379

# Option 2: Redis Cloud or other remote Redis
# REDIS_URL=redis://user:password@host:port

# ============================================================
# Email (Nodemailer)
# ============================================================
# Leave empty for development mode (logs emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agrireports.com

# ============================================================
# WhatsApp (Meta Cloud API)
# ============================================================
# Leave empty for development mode (logs messages to console)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=agrireports_verify
META_APP_SECRET=

# ============================================================
# Notifications
# ============================================================
# Set to 'true' to use queue, 'false' for direct sending
USE_NOTIFICATION_QUEUE=false

# ============================================================
# App Base URL (for notification links)
# ============================================================
APP_BASE_URL=http://localhost:3000
