{
  "dashboard": {
    "id": null,
    "uid": "agrireports-main",
    "title": "AgriReports Platform Dashboard",
    "tags": ["agrireports", "prometheus"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{route}} - {{status_code}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Requests/sec", "min": 0 },
          { "show": false }
        ]
      },
      {
        "id": 2,
        "title": "HTTP Request Duration (P95)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P50",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "label": "Duration (s)", "min": 0, "format": "s" },
          { "show": false }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(http_errors_total[5m])",
            "legendFormat": "{{error_type}} - {{route}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Errors/sec", "min": 0 },
          { "show": false }
        ]
      },
      {
        "id": 4,
        "title": "Reports by Status",
        "type": "stat",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "reports_by_status_total",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      },
      {
        "id": 5,
        "title": "Reports Created (Last 24h)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "increase(reports_created_total[24h])",
            "legendFormat": "{{period}} - {{category}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Reports", "min": 0 },
          { "show": false }
        ]
      },
      {
        "id": 6,
        "title": "Reports Reviewed (Last 24h)",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
        "targets": [
          {
            "expr": "increase(reports_reviewed_total[24h])",
            "legendFormat": "{{decision}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Notification Success Rate",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
        "targets": [
          {
            "expr": "sum(rate(notifications_sent_total{status=\"success\"}[5m])) / sum(rate(notifications_sent_total[5m])) * 100",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 90 },
                { "color": "green", "value": 95 }
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Notifications by Channel",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "rate(notifications_sent_total[5m])",
            "legendFormat": "{{channel}} - {{event}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Notifications/sec", "min": 0 },
          { "show": false }
        ]
      },
      {
        "id": 9,
        "title": "Queue Depth",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "queue_depth",
            "legendFormat": "{{queue_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Jobs", "min": 0 },
          { "show": false }
        ]
      },
      {
        "id": 10,
        "title": "Queue Job Duration",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(queue_job_duration_seconds_bucket[5m]))",
            "legendFormat": "{{queue_name}} - P95",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Duration (s)", "min": 0, "format": "s" },
          { "show": false }
        ]
      },
      {
        "id": 11,
        "title": "Database Connections",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
        "targets": [
          {
            "expr": "database_connections_active",
            "legendFormat": "Active Connections",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 12,
        "title": "Active Sessions",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 32 },
        "targets": [
          {
            "expr": "auth_active_sessions",
            "legendFormat": "Sessions",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 13,
        "title": "Database Query Duration (P95)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "{{operation}} - {{table}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Duration (s)", "min": 0, "format": "s" },
          { "show": false }
        ]
      },
      {
        "id": 14,
        "title": "Login Attempts",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
        "targets": [
          {
            "expr": "rate(auth_login_attempts_total[5m])",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "Attempts/sec", "min": 0 },
          { "show": false }
        ]
      },
      {
        "id": 15,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
            "legendFormat": "Used Memory",
            "refId": "A"
          },
          {
            "expr": "node_memory_MemTotal_bytes",
            "legendFormat": "Total Memory",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "label": "Bytes", "min": 0, "format": "bytes" },
          { "show": false }
        ]
      },
      {
        "id": 16,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU %",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "CPU %", "min": 0, "max": 100, "format": "percent" },
          { "show": false }
        ]
      }
    ],
    "time": { "from": "now-6h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "custom",
          "options": [
            { "text": "development", "value": "development" },
            { "text": "staging", "value": "staging" },
            { "text": "production", "value": "production" }
          ]
        }
      ]
    }
  },
  "overwrite": true
}
