# AgriReports - Local Development Configuration

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database - PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrireports

# Redis - Optional (queue will work in direct mode)
REDIS_URL=

# Email - Development mode (logs to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agrireports.com

# WhatsApp - Development mode (logs to console)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=agrireports_verify
META_APP_SECRET=

# Notifications - Direct mode (no queue)
USE_NOTIFICATION_QUEUE=false

# App Base URL
APP_BASE_URL=http://localhost:3000
